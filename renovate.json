{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ENV \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["@opencode-ai/cli"],
      "allowedVersions": "/^0\\.0\\.0-beta-/"
    },
    {
      "matchPackagePatterns": [".*"],
      "groupName": "All Dependencies"
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0
}
